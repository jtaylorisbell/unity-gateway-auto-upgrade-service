# Local settings for the dev target. Copy to .env (gitignored) and load with `uv run --env-file .env <command>`.

# A profile in ~/.databrickscfg. Create one with: databricks auth login -p <profile>
DATABRICKS_CONFIG_PROFILE=

# Optional: deploy dev somewhere other than the catalog and schema in databricks.yml. Model service names aren't
# prefixed in development mode, so developers who share a schema overwrite each other's services.
# BUNDLE_VAR_catalog=
# BUNDLE_VAR_schema=
